# ==============================================================================
# Application Environment Variables
# ==============================================================================

# Server
PORT=8080
CORS_ENABLED=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=arikatto
DB_SSLMODE=disable

# JWT / RSA Authentication
# Option 1: Provide PEM strings directly:
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Option 2: Provide file paths:
JWT_PRIVATE_KEY_PATH=./keys/app.rsa
JWT_PUBLIC_KEY_PATH=./keys/app.rsa.pub

# Token expiration duration in hours
JWT_DURATION_HOURS=2
